# Copy to .env and adjust. .env is git-ignored and never committed.
# Defaults point at the free Cisco DevNet ALWAYS-ON sandboxes (no reservation, no VPN).

# --- Catalyst Center (formerly DNA Center) always-on sandbox ---
NETSIM_DNAC_BASE_URL=https://sandboxdnac.cisco.com
NETSIM_DNAC_USERNAME=devnetuser
NETSIM_DNAC_PASSWORD=Cisco123!
NETSIM_DNAC_VERSION=2.3.7.6
NETSIM_DNAC_VERIFY=false

# --- Identity Services Engine (ISE) always-on sandbox ---
# Host is internet-reachable. The ERS username/password are shown on the sandbox
# page after a free DevNet login - update these two if the published values change:
#   https://devnetsandbox.cisco.com  ->  "Identity Services Engine (ISE) - Always-On"
NETSIM_ISE_BASE_URL=https://devnetsandboxise.cisco.com
NETSIM_ISE_USERNAME=readonly
NETSIM_ISE_PASSWORD=ISEisC00L
NETSIM_ISE_ERS_USERNAME=readonly
NETSIM_ISE_ERS_PASSWORD=ISEisC00L
NETSIM_ISE_VERIFY=false

# --- Optional: Catalyst 9800 Wireless LAN Controller (RESTCONF) ---
# The DevNet 9800 sandbox is RESERVED (book a slot + AnyConnect VPN), not
# always-on. Once connected, set ENABLED=true and point BASE_URL at the WLC
# management IP, then run the wireless scenarios with --mode record to capture a
# cassette (fixtures/wlc/) for offline replay. Credentials come from the
# reservation page (often developer/C1sco12345 or admin/C1sco12345).
NETSIM_WLC_ENABLED=false
NETSIM_WLC_BASE_URL=https://10.10.20.51
NETSIM_WLC_USERNAME=developer
NETSIM_WLC_PASSWORD=C1sco12345
NETSIM_WLC_VERIFY=false

# --- Optional: Meraki always-on dashboard (wireless) ---
# NETSIM_MERAKI_API_KEY=
# NETSIM_MERAKI_BASE_URL=https://api.meraki.com/api/v1

# --- Framework behaviour ---
# live | record | replay   (replay = fully offline, from fixtures/)
NETSIM_MODE=replay
NETSIM_TOPOLOGY=topologies/campus-small.yaml
